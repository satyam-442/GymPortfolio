<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>ServiceNow Quick Open</title>
  <style>
    /* The core changes are in the CSS, where I've refined the color palette,
      typography, and layout to create a more polished aesthetic.
    */
    :root {
      --bg: #0c0a09; /* stone-950 */
      --card: #1c1917; /* stone-900 */
      --muted: #a8a29e; /* stone-400 */
      --text: #e7e5e4; /* stone-200 */
      --accent: #22d3ee; /* cyan-400 */
      --accent-2: #c084fc; /* violet-400 */
      --ring: rgba(34, 211, 238, 0.45);
    }
    * { box-sizing: border-box; }
    html, body { height: 100%; }
    body {
      margin: 0;
      font-family: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, "Apple Color Emoji", "Segoe UI Emoji";
      background: radial-gradient(1200px 800px at 20% 10%, rgba(192, 132, 252, .15), transparent),
                  radial-gradient(900px 600px at 90% 20%, rgba(34, 211, 238, .12), transparent),
                  var(--bg);
      color: var(--text);
      display: grid;
      place-items: center;
      padding: 24px;
    }
    .card {
      width: 100%;
      max-width: 720px;
      background: linear-gradient(180deg, rgba(255,255,255,0.04), rgba(255,255,255,0.02));
      backdrop-filter: blur(8px);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 20px;
      box-shadow: 0 10px 40px rgba(0,0,0,0.45);
      padding: 40px; /* Increased padding for better spacing */
      display: flex;
      flex-direction: column;
      gap: 24px; /* Added gap for consistent spacing between elements */
    }
    h1 {
      margin: 0;
      font-size: 2.5rem; /* Larger, more prominent heading */
      font-weight: 700;
      letter-spacing: -0.5px;
    }
    p.sub {
      margin: 0;
      color: var(--muted);
      font-size: 16px; /* Slightly larger for readability */
      max-width: 500px;
      line-height: 1.5;
    }
    .row {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 20px; /* Increased gap for better visual separation */
      align-items: center;
      padding: 16px; /* Slightly larger padding */
      background: rgba(255,255,255,0.03);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 16px;
      transition: background 0.2s ease; /* Smooth transition on hover */
    }
    .row:hover {
      background: rgba(255,255,255,0.05); /* Lighter background on hover */
    }
    label {
      display: block;
      font-size: 14px; /* Slightly larger label */
      color: var(--muted);
      margin-bottom: 8px; /* Increased margin */
      font-weight: 500;
    }
    .field { display: flex; flex-direction: column; }
    input[type="text"] {
      width: 100%;
      padding: 14px; /* More vertical padding */
      border-radius: 12px;
      border: 1px solid rgba(255,255,255,0.08);
      background: rgba(17, 24, 39, 0.65);
      color: var(--text);
      outline: none;
      font-size: 16px; /* Larger font size for input */
      transition: box-shadow .15s ease, border-color .15s ease;
    }
    input[type="text"]:focus {
      box-shadow: 0 0 0 4px var(--ring);
      border-color: var(--accent);
    }
    button {
      height: 52px; /* Taller button for easier clicking */
      padding: 0 24px; /* More horizontal padding */
      border: none;
      border-radius: 12px;
      background: linear-gradient(135deg, var(--accent), var(--accent-2));
      color: #0b1020;
      font-weight: 700;
      cursor: pointer;
      letter-spacing: .2px;
      transition: transform .06s ease, filter .2s ease;
      white-space: nowrap; /* Prevents text from wrapping on smaller screens */
    }
    button:hover { filter: brightness(1.05); }
    button:active { transform: translateY(1px); }
    @media (max-width: 520px) {
      .row { grid-template-columns: 1fr; }
      button { width: 100%; height: 48px; }
      .card { padding: 24px; }
    }
  </style>
</head>
<body>
  <main class="card">
    <h1>ServiceNow Quick Open</h1>
    <p class="sub">Enter your Incident or Request number and open it directly in ServiceNow.</p>
    <div class="row">
      <div class="field">
        <label for="incInput">Incident Number (INC)</label>
        <input id="incInput" type="text" placeholder="INC1234567" />
      </div>
      <button id="incBtn" aria-label="Open Incident">Open INC</button>
    </div>
    <div class="row">
      <div class="field">
        <label for="reqInput">Request Number (REQ)</label>
        <input id="reqInput" type="text" placeholder="REQ9876543" />
      </div>
      <button id="reqBtn" aria-label="Open Request">Open REQ</button>
    </div>
  </main>
  <script>
    // 🔧 Replace with your real ServiceNow instance URL
    const SN_INSTANCE = "https://yourcompany.service-now.com";
    function openSNRecord(type, inputId) {
      const val = document.getElementById(inputId).value.trim().toUpperCase();
      if (!val || !val.startsWith(type)) {
        alert(`Please enter a valid ${type} number (e.g., ${type}1234567)`);
        return;
      }
      // Construct URL: adjust table names as per your SN setup
      let table = type === "INC" ? "incident" : "sc_request";
      let url = `${SN_INSTANCE}/${table}.do?sysparm_query=number=${val}`;
      window.open(url, "_blank", "noopener");
    }
    document.getElementById("incBtn").addEventListener("click", () => openSNRecord("INC", "incInput"));
    document.getElementById("reqBtn").addEventListener("click", () => openSNRecord("REQ", "reqInput"));
    // Allow Enter key
    [["incInput","incBtn"],["reqInput","reqBtn"]].forEach(([inp, btn]) => {
      document.getElementById(inp).addEventListener("keydown", (e) => {
        if (e.key === "Enter") {
          e.preventDefault();
          document.getElementById(btn).click();
        }
      });
    });
  </script>
</body>
</html>
