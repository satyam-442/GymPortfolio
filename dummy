<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Main Menu</title>
  <style>
    /* === Your Strict Stylesheet === */
    :root {
      --bg: #090b0c; /* stone-950 */
      --card: #1c1917; /* stone-900 */
      --muted: #a8a29e; /* stone-400 */
      --text: #e7e5e4; /* stone-200 */
      --accent: #22d3ee; /* cyan-400 */
      --accent-2: #c084fc; /* violet-400 */
      --ring: rgba(34, 211, 238, 0.45);
    }
    * { box-sizing: border-box; }
    html, body { height: 100%; }
    body {
      margin: 0;
      font-family: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, "Apple Color Emoji", "Segoe UI Emoji";
      background: radial-gradient(1200px 800px at 20% 10%, rgba(192, 132, 252, .15), transparent),
                  radial-gradient(900px 600px at 90% 20%, rgba(34, 211, 238, .12), transparent),
                  var(--bg);
      color: var(--text);
      display: grid;
      place-items: center;
      padding: 24px;
    }
    .card {
      width: 100%;
      max-width: 720px;
      background: linear-gradient(180deg, rgba(255,255,255,0.04), rgba(255,255,255,0.02));
      backdrop-filter: blur(8px);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 20px;
      box-shadow: 0 10px 40px rgba(0,0,0,0.45);
      padding: 40px;
      display: flex;
      flex-direction: column;
      gap: 24px;
      animation: fadeIn 0.8s ease-in-out;
    }
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }
    h1.card-title {
      margin: 0;
      font-size: 1.75rem;
      font-weight: 800;
      letter-spacing: -1px;
      text-shadow: 0 0 10px rgba(34, 211, 238, 0.2);
    }
    p.sub {
      margin: 0;
      color: var(--muted);
      font-size: 16px;
      max-width: 500px;
      line-height: 1.5;
    }
    /* --- Card Menu Styles --- */
    .menu {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }
    .menu-card {
      position: relative;
      padding: 20px;
      border-radius: 16px;
      background: rgba(255,255,255,0.03);
      border: 1px solid rgba(255,255,255,0.08);
      cursor: pointer;
      transition: transform 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
      overflow: hidden;
      z-index: 1;
      display: flex; /* Added for icon positioning */
      justify-content: space-between; /* Added for icon positioning */
      align-items: center; /* Added for icon positioning */
    }
    .menu-card-content { /* New wrapper for text content */
      flex-grow: 1;
    }
    .menu-card:hover {
      background: rgba(255,255,255,0.06);
      transform: translateY(-5px) scale(1.02);
      box-shadow: 0 10px 20px rgba(0,0,0,0.3);
    }
    .menu-card::before {
      content: '';
      position: absolute;
      top: -50%;
      left: -50%;
      width: 200%;
      height: 200%;
      background: radial-gradient(circle, rgba(34, 211, 238, 0.1), transparent 70%);
      transform: rotate(45deg);
      opacity: 0;
      transition: opacity 0.3s ease;
      z-index: -1;
    }
    .menu-card:hover::before {
      opacity: 1;
    }
    .menu-card h2 {
      margin: 0 0 6px;
      font-size: 1.4rem;
      font-weight: 600;
      transition: color 0.2s ease;
    }
    .menu-card:hover h2 {
      color: var(--accent);
    }
    .menu-card p {
      margin: 0;
      font-size: 14px;
      color: var(--muted);
      transition: color 0.2s ease;
    }
    .menu-card:hover p {
      color: var(--text);
    }
    /* Arrow Icon Styling */
    .card-icon {
      margin-left: 20px;
      color: var(--muted);
      transition: transform 0.2s ease, color 0.2s ease;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .menu-card:hover .card-icon {
      color: var(--accent);
      transform: translateX(5px);
    }
    .card-icon svg {
      width: 20px;
      height: 20px;
      stroke-width: 2;
      stroke: currentColor;
      fill: none;
    }

    @media (max-width: 520px) {
      .card { padding: 24px; }
      h1.card-title { font-size: 1.75rem; }
    }
  </style>
</head>
<body>
  <main class="card">
    <h1 class="card-title">4DATA Utilities</h1>
    <p class="sub">Choose a tool to continue:</p>

    <div class="menu">
      <div class="menu-card" onclick="location.href='quick-open.html'">
        <div class="menu-card-content">
          <h2>ServiceNow Quick Open</h2>
          <p>Open INC and REQ numbers directly in ServiceNow.</p>
        </div>
        <span class="card-icon">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </span>
      </div>

      <div class="menu-card" onclick="location.href='description-generator.html'">
        <div class="menu-card-content">
          <h2>ServiceNow Description Generator</h2>
          <p>Create structured ticket descriptions quickly.</p>
        </div>
        <span class="card-icon">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </span>
      </div>

      <div class="menu-card" onclick="location.href='airflow-runner.html'">
        <div class="menu-card-content">
          <h2>Airflow DAG Runner</h2>
          <p>Trigger and monitor Airflow DAG executions.</p>
        </div>
        <span class="card-icon">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </span>
      </div>
    </div>
  </main>
</body>
</html>
